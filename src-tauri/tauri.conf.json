{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Al Huruf",
  "version": "0.1.10",
  "identifier": "com.ibrahimsalah.hisabjomal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../release-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "أطلس الحروف",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "أداة عربية للأسماء وحساب الحروف والتراث"
  }
}
